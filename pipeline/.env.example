# Copy to .env and fill in. .env is gitignored; never commit tokens.

# Discord bot token (Developer Portal → your application → Bot → Reset Token)
DISCORD_TOKEN=
# ID of the "ideas" forum channel (Discord: User Settings → Advanced → Developer Mode, then right-click the channel → Copy Channel ID)
DISCORD_IDEAS_CHANNEL_ID=

# Repository that holds the idea issues
GITHUB_REPO=kdraggoo/agentic-crm
# Optional: falls back to the token from `gh auth login`
GITHUB_TOKEN=

# Optional tuning
# PO_MODEL=opus
# PO_TIMEOUT_MS=600000
# REPLY_DEBOUNCE_MS=20000
# REPO_DIR=..   (repo checkout the agents read; defaults to the repo containing this folder)
