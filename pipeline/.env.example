# Copy to .env and fill in. .env is gitignored; never commit tokens.

# Discord bot token (Developer Portal → your application → Bot → Reset Token)
DISCORD_TOKEN=
# ID of the "ideas" forum channel (Discord: User Settings → Advanced → Developer Mode, then right-click the channel → Copy Channel ID)
DISCORD_IDEAS_CHANNEL_ID=
# Your Discord user ID (Developer Mode on, right-click your name → Copy User ID). The bot ignores everyone else.
DISCORD_OWNER_ID=

# Repository that holds the idea issues
GITHUB_REPO=kdraggoo/agentic-crm
# Optional: falls back to the token from `gh auth login`
GITHUB_TOKEN=

# Optional tuning
# PO_MODEL=opus
# PO_TIMEOUT_MS=600000
# REPLY_DEBOUNCE_MS=20000
# TLS_ECDH_CURVE=X25519:P-256   (only if GitHub calls fail with ERR_SSL_WRONG_VERSION_NUMBER on your network)
# REPO_DIR=..   (repo checkout the agents read; defaults to the repo containing this folder)

# Optional: test and build agents
# BUILD_MODEL=opus
# TEST_MODEL=opus   (defaults to BUILD_MODEL)
# TEST_TIMEOUT_MS=2700000
# BUILD_TIMEOUT_MS=2700000
# MAX_BUILD_ATTEMPTS=3
# REVIEW_MODEL=opus
# REVIEW_TIMEOUT_MS=1200000
# CI_TIMEOUT_MS=1800000   (how long to wait for GitHub CI on a build)
# WORKTREES_DIR=../../worktrees   (one git worktree per idea; defaults to a "worktrees" folder next to the repo)
# NODE_BIN_DIR=/opt/homebrew/opt/node@24/bin   (Node version the app needs, see .nvmrc)
